# ====== Build / Artifact ======
/build/
/build_*/
/build-*/
/out/
/cmake-build-*/
/dist/
/.deps/

# Vendored dependencies are source-only. All generated dependency build and
# install products belong under .deps/ and must never re-enter third_party/src.
third_party/src/**/CMakeFiles/
third_party/src/**/.qmake.stash
third_party/src/**/Makefile.Debug
third_party/src/**/Makefile.Release
third_party/src/**/*.obj
third_party/src/**/*.lib
third_party/src/**/*.dll
third_party/src/**/*.pdb

# ====== CMake / Ninja / CTest ======
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
*.ninja
.ninja_deps
.ninja_logs
Testing/

# ====== 编辑器 / IDE ======
.vscode/
.vs/
.idea/
*.swp
*.swo
*~

# ====== 系统 / 桌面 ======
Thumbs.db
.DS_Store
desktop.ini

# ====== 临时 & 日志 ======
*.log
*.tmp
*.bak
/*.obj

# Root-level GUI/manual verification evidence is generated on demand and must
# not become repository state.  Large local fixtures are intentionally kept
# outside Git as well.
/gui-*.png
/gui-*-data*/
/gui-manual-*/
/gui-old-probe-data/
/bigtestfile
/smalltestfile
/tinytestfile

# ====== Python 辅助脚本产物（app.ico 已生成，保留） ======
# 不排除 resources/app.ico 和 resources/notepad_safe.png（这些是仓库必需品）
__pycache__/
*.py[cod]

# ====== 测试生成临时目录 ======
tests/tmp_*
tests/_tmp_*
_temp_*
