#include <windows.h>
// EXE 图标（资源 ID=1，Windows 约定首个图标用于 EXE 文件）
1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

// 应用程序版本信息
VS_VERSION_INFO VERSIONINFO
FILEVERSION    @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName",      "NotepadSafe\0"
            VALUE "FileDescription",  "Notepad Safe - Encrypted Notepad Editor\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0\0"
            VALUE "InternalName",     "notepad-safe\0"
            VALUE "LegalCopyright",   "2025 NotepadSafe Authors (GPL v3)\0"
            VALUE "OriginalFilename", "notepad-safe.exe\0"
            VALUE "ProductName",      "Notepad Safe\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
